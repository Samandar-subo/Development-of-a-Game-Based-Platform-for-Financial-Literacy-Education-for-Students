# Пример конфигурации. Скопируйте в .env и заполните собственными значениями.
# Никогда не коммитьте .env и реальные ключи.

PORT=3000
NODE_ENV=development

DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/finance_game

JWT_ACCESS_SECRET=replace_with_long_random_value
JWT_REFRESH_SECRET=replace_with_another_long_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
